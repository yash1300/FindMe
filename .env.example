# Copy to .env.local for local development. Never commit real values.
# For the local stack, `npx supabase start` prints the Supabase values.

# Canonical origin, with no trailing slash. Everything derives from this; findme.com is never hardcoded.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

NEXT_PUBLIC_SUPABASE_URL=
# Public by design. Safe only because Row Level Security is enforced.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses Row Level Security. Server only; never add a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Set to true only after Google is configured in Supabase (see DEPLOYMENT.md).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Optional. Shown on legal and suspension pages. Hidden when unset.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Later phases. Not used yet.
# RESEND_API_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Copy to .env.local and fill in. Step-by-step instructions are in ENV_SETUP.md.
# Never commit real values.

# Canonical origin, with no trailing slash. Everything derives from this; findme.com is never hardcoded.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

NEXT_PUBLIC_SUPABASE_URL=
# Public by design. Safe only because Row Level Security is enforced.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses Row Level Security. Server only; never add a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Set to true only after Google is configured in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Shown on legal and suspension pages. Hidden when unset.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional. Without these, form messages are saved but no notification emails are sent.
# RESEND_API_KEY is SECRET.
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_INBOX_EMAIL=

# SECRET. Lets Vercel run the daily maintenance job. Any long random string.
CRON_SECRET=

# SECRET. Connect verified custom domains to the Vercel project. Add VERCEL_TEAM_ID if under a team.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
